{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-control dataset catalog entry",
  "type": "object",
  "required": ["id", "name", "kind", "description", "origin", "file", "columns", "license",
               "sampling_time_s", "n_rows", "limitations", "generator", "sha256"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ds_[a-z0-9_]+$"},
    "name": {"type": "string"},
    "kind": {"enum": ["measured_experiment", "public_dataset", "simulated", "synthetic_illustrative"]},
    "description": {"type": "string"},
    "origin": {"type": "string", "description": "Who or what produced the data. For synthetic data, the generator and seed."},
    "file": {"type": "string"},
    "license": {"type": "string"},
    "sampling_time_s": {"type": "number", "exclusiveMinimum": 0},
    "n_rows": {"type": "integer", "minimum": 1},
    "columns": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "unit", "description"],
                "additionalProperties": false,
                "properties": {"name": {"type": "string"}, "unit": {"type": "string"},
                               "description": {"type": "string"}}}
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "used_by": {"type": "array", "items": {"type": "string"}},
    "generator": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "synthetic_illustrative"}}},
     "then": {"required": ["seed"], "properties": {"generator": {"type": "string"}, "seed": {"type": "integer"}}}}
  ]
}
